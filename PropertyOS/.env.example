# Optional. Leave both blank for a local offline workspace.
# Copy this file to .env.local for development. Add these in Vercel for cloud use.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy Supabase anon keys are also supported via VITE_SUPABASE_ANON_KEY.
# Never place a Supabase service_role or secret key in a VITE_ variable.
