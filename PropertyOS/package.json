{
  "name": "propertyos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/clean-dist.mjs && node scripts/sync-schema.mjs && tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "mobile:android": "tauri android dev",
    "mobile:ios": "tauri ios dev",
    "format": "prettier --write src tests scripts docs README.md IMPLEMENTATION_STATUS.md",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/supabase-js": "2.117.3",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@tauri-apps/plugin-fs": "2.4.5",
    "lucide-react": "1.31.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.0",
    "regenerator-runtime": "0.14.1",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "2.11.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
